-keep public class org.microemu.** { public protected *; }
-keep class io.github.h3nb.jlmodplus.util.SparseIntArrayAdapter { *; }
-keep class io.github.h3nb.jlmodplus.BuildConfig { *; }
-keep class io.github.h3nb.jlmodplus.crashes.models.* { *; }

# Preserve all public MIDlets.
-keep public class * extends javax.microedition.midlet.MIDlet

# Preserve native method names and the names of their classes.
-keepclasseswithmembernames class * {
    native <methods>;
}

# A port may need additional rules for classes resolved dynamically by the MIDlet.
# Prefer narrow app-specific rules here rather than widening the global keep surface.
