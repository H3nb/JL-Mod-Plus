<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="library_share"
        path="library-share/" />
    <cache-path
        name="library_export"
        path="library-export/" />
    <!-- Bulk transfer artifacts are published separately from single-app exports so one active
         operation cannot replace another artifact. Keep both roots allowlisted for FileProvider. -->
    <cache-path
        name="library_share_bulk"
        path="library-share-bulk/" />
    <cache-path
        name="library_export_bulk"
        path="library-export-bulk/" />
    <!-- Read grants are issued only for selected legacy ZIP URIs, never the directory. -->
    <external-path name="legacy_diagnostic_bundles" path="Download/JL-Mod Plus Diagnostics/" />
</paths>
