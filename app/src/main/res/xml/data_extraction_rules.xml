<?xml version="1.0" encoding="utf-8"?>
<!-- Keep cloud backup and device transfer disabled for emulator state. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
