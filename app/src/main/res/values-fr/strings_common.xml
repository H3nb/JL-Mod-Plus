    <string name="about_build_label">Build</string>
    <string name="about_revision_label">Révision source</string>
    <string name="about_links_title">Projet et licences</string>
    <string name="about_github_link_copied">Aucun navigateur trouvé. Lien GitHub copié dans le presse-papiers.</string>
    <string name="about_github_browser_unavailable">Aucun navigateur trouvé pour ouvrir GitHub.</string>
    <string name="about_lineage">JL-Mod Plus est un fork indépendant de JL-Mod par woesss (Yury Kharchenko). JL-Mod est basé sur J2ME Loader de Nikita Shakarun, lui-même issu de J2meLoader de NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus s’appuie sur cette base en y ajoutant une interface moderne, une bibliothèque de MIDlets plus complète, de nouvelles fonctionnalités et la prise en charge des versions récentes d’Android.</string>
