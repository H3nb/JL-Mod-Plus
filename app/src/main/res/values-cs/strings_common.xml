    <string name="about">O aplikaci</string>
    <string name="about_message">Spouštějte klasické aplikace a hry, organizujte MIDlety v knihovně a přizpůsobujte si ovládání, zobrazení, zvuk i výkon. JL-Mod Plus je bezplatná aplikace s otevřeným zdrojovým kódem.</string>
    <string name="about_subtitle">Emulátor Java ME pro Android</string>
    <string name="about_compatibility">Kompatibilita závisí na MIDletu, zařízení a podporovaných rozhraních Java ME API. Některé aplikace se mohou chovat jinak než na původních telefonech.</string>
    <string name="about_lineage_title">Původ projektu</string>
    <string name="about_build_title">Informace o sestavení</string>
    <string name="about_version_label">Verze</string>
    <string name="about_build_label">Sestavení</string>
    <string name="about_revision_label">Revize zdrojového kódu</string>
    <string name="about_links_title">Projekt a licence</string>
    <string name="about_github_link_copied">Nebyl nalezen žádný prohlížeč. Odkaz na GitHub byl zkopírován do schránky.</string>
    <string name="about_github_browser_unavailable">Nebyl nalezen žádný prohlížeč pro otevření GitHubu.</string>
    <string name="about_lineage">JL-Mod Plus je nezávislý fork aplikace JL-Mod od woessse (Yury Kharchenko). JL-Mod vychází z aplikace J2ME Loader od Nikity Shakaruna, která navazuje na J2meLoader od NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus na tomto základu staví moderní rozhraní, schopnější knihovnu MIDletů, nové funkce a podporu novějších verzí systému Android.</string>
