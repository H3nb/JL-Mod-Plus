    <string name="about">Giới thiệu</string>
    <string name="about_message">Chạy các ứng dụng và trò chơi cổ điển, sắp xếp MIDlet trong thư viện và tùy chỉnh điều khiển, hiển thị, âm thanh cũng như hiệu năng. JL-Mod Plus hoàn toàn miễn phí và mã nguồn mở.</string>
    <string name="about_subtitle">Trình giả lập Java ME cho Android</string>
    <string name="about_compatibility">Khả năng tương thích tùy thuộc vào MIDlet, thiết bị và các API Java ME được hỗ trợ. Một số ứng dụng có thể hoạt động khác so với trên điện thoại gốc.</string>
    <string name="about_lineage_title">Nguồn gốc dự án</string>
    <string name="about_build_title">Thông tin bản dựng</string>
    <string name="about_version_label">Phiên bản</string>
    <string name="about_build_label">Bản dựng</string>
    <string name="about_revision_label">Bản sửa đổi mã nguồn</string>
    <string name="about_links_title">Dự án và giấy phép</string>
    <string name="about_github_link_copied">Không tìm thấy trình duyệt. Đã sao chép liên kết GitHub vào bộ nhớ tạm.</string>
    <string name="about_github_browser_unavailable">Không tìm thấy trình duyệt để mở GitHub.</string>
    <string name="about_lineage">JL-Mod Plus là nhánh phát triển độc lập từ JL-Mod của woesss (Yury Kharchenko). JL-Mod dựa trên J2ME Loader của Nikita Shakarun, vốn bắt nguồn từ J2meLoader của NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus phát triển trên nền tảng đó với giao diện hiện đại, thư viện MIDlet mạnh mẽ hơn, nhiều tính năng mới và hỗ trợ các phiên bản Android mới hơn.</string>
