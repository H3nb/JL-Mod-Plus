<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="about">Πληροφορίες</string>
    <string name="about_message">Εκτελέστε κλασικές εφαρμογές και παιχνίδια, οργανώστε τα MIDlet στη βιβλιοθήκη σας και προσαρμόστε τα χειριστήρια, την οθόνη, τον ήχο και την απόδοση. Το JL-Mod Plus είναι δωρεάν και ανοιχτού κώδικα.</string>
    <string name="about_subtitle">Εξομοιωτής Java ME για Android</string>
    <string name="about_compatibility">Η συμβατότητα εξαρτάται από το MIDlet, τη συσκευή και τα υποστηριζόμενα API της Java ME. Ορισμένες εφαρμογές ενδέχεται να λειτουργούν διαφορετικά από ό,τι στις αρχικές συσκευές.</string>
    <string name="about_lineage_title">Προέλευση έργου</string>
    <string name="about_build_title">Πληροφορίες έκδοσης</string>
    <string name="about_version_label">Έκδοση</string>
    <string name="about_build_label">Δομή</string>
    <string name="about_revision_label">Αναθεώρηση πηγαίου κώδικα</string>
    <string name="about_links_title">Έργο και άδειες</string>
    <string name="about_github_link_copied">Δεν βρέθηκε πρόγραμμα περιήγησης. Ο σύνδεσμος GitHub αντιγράφηκε στο πρόχειρο.</string>
    <string name="about_github_browser_unavailable">Δεν βρέθηκε πρόγραμμα περιήγησης για το άνοιγμα του GitHub.</string>
    <string name="about_lineage">Το JL-Mod Plus είναι μια ανεξάρτητη διακλάδωση του JL-Mod από τον woesss (Yury Kharchenko). Το JL-Mod βασίζεται στο J2ME Loader του Nikita Shakarun, το οποίο προέρχεται από το J2meLoader της NaikSoftware.</string>
    <string name="about_evolution">Το JL-Mod Plus αξιοποιεί αυτή τη βάση και προσφέρει σύγχρονη διεπαφή, πιο ολοκληρωμένη βιβλιοθήκη MIDlet, νέες δυνατότητες και υποστήριξη για νεότερες εκδόσεις Android.</string>
