    <string name="about_compatibility">התאימות תלויה ב־MIDlet, במכשיר ובממשקי ה־API הנתמכים של Java ME. יישומים מסוימים עשויים לפעול אחרת מכפי שפעלו בטלפונים המקוריים שלהם.</string>
    <string name="about_evolution">JL-Mod Plus מרחיב את הבסיס הזה עם ממשק מודרני, ספריית MIDlet עם יכולות משופרות, מגוון תכונות חדשות ותמיכה בגרסאות Android חדשות יותר.</string>
    <string name="about_github_browser_unavailable">אין דפדפן זמין לפתיחת GitHub.</string>
    <string name="about_github_link_copied">אין דפדפן זמין. הקישור ל־GitHub הועתק ללוח.</string>
    <string name="about_lineage">JL-Mod Plus הוא פיצול עצמאי של JL-Mod מאת woesss (Yury Kharchenko). JL-Mod מבוסס על J2ME Loader מאת Nikita Shakarun, שמקורו ב־J2meLoader של NaikSoftware.</string>
    <string name="about_lineage_title">מקורות הפרויקט</string>
