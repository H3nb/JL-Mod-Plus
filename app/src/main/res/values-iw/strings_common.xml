    <string name="about_revision_label">גרסת קוד מקור</string>
    <string name="about_links_title">פרויקט ורישיונות</string>
    <string name="about_github_link_copied">לא נמצא דפדפן. הקישור ל-GitHub הועתק ללוח.</string>
    <string name="about_github_browser_unavailable">לא נמצא דפדפן לפתיחת GitHub.</string>
    <string name="about_lineage">JL-Mod Plus הוא פיצול עצמאי של JL-Mod מאת woesss (Yury Kharchenko). JL-Mod מבוסס על J2ME Loader מאת Nikita Shakarun, שראשיתו ב-J2meLoader של NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus מרחיב תשתית זו עם ממשק מודרני, ספריית MIDlet מתקדמת יותר, תכונות חדשות ותמיכה בגרסאות Android חדשות יותר.</string>
