    <string name="memory_editor_revert_remove_outcome">שוחזרו: <xliff:g id="restored" example="2">%1$d</xliff:g>. הוסרו: <xliff:g id="removed" example="2">%2$d</xliff:g>. התנגשויות: <xliff:g id="conflicts" example="0">%3$d</xliff:g>. לא אומתו: <xliff:g id="unconfirmed" example="0">%4$d</xliff:g>. לא נוסו: <xliff:g id="not_attempted" example="0">%5$d</xliff:g>.</string>
