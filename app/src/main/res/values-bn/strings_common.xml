<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="about">পরিচিতি</string>
    <string name="about_message">ক্লাসিক অ্যাপ ও গেম চালান, আপনার লাইব্রেরিতে MIDlet সাজিয়ে রাখুন এবং কন্ট্রোল, ডিসপ্লে, অডিও ও পারফরম্যান্স কাস্টমাইজ করুন। JL-Mod Plus সম্পূর্ণ বিনামূল্যে এবং ওপেন সোর্স।</string>
    <string name="about_subtitle">Android-এর জন্য Java ME এমুলেটর</string>
    <string name="about_compatibility">কম্প্যাটিবিলিটি নির্ভর করে MIDlet, ডিভাইস এবং সাপোর্ট করা Java ME API-এর ওপর। কিছু অ্যাপ তাদের আসল ফোনের তুলনায় ভিন্নভাবে কাজ করতে পারে।</string>
    <string name="about_lineage_title">প্রজেক্টের উৎস</string>
    <string name="about_build_title">বিল্ড তথ্য</string>
    <string name="about_version_label">ভার্সন</string>
    <string name="about_build_label">বিল্ড</string>
    <string name="about_revision_label">সোর্স রিভিশন</string>
    <string name="about_links_title">প্রজেক্ট ও লাইসেন্স</string>
    <string name="about_github_link_copied">কোনো ব্রাউজার পাওয়া যায়নি। GitHub লিংক ক্লিপবোর্ডে কপি করা হয়েছে।</string>
    <string name="about_github_browser_unavailable">GitHub খোলার জন্য কোনো ব্রাউজার পাওয়া যায়নি।</string>
    <string name="about_lineage">JL-Mod Plus হলো woesss (Yury Kharchenko)-এর তৈরি JL-Mod-এর একটি স্বাধীন ফর্ক। JL-Mod তৈরি হয়েছে Nikita Shakarun-এর J2ME Loader-এর ওপর ভিত্তি করে, যার সূচনা NaikSoftware-এর J2meLoader থেকে।</string>
    <string name="about_evolution">সেই ভিত্তির ওপর দাঁড়িয়ে JL-Mod Plus-এ যুক্ত হয়েছে আধুনিক ইন্টারফেস, আরও শক্তিশালী MIDlet লাইব্রেরি, নতুন ফিচার এবং নতুন Android ভার্সনের সাপোর্ট।</string>
