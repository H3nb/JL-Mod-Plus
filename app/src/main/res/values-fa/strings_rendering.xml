    <string name="internal_resolution_description" tools:ignore="MissingTranslation">وضوح رندر گرافیک دوبعدی و سه‌بعدی پشتیبانی‌شده را تنظیم می‌کند. حالت خودکار مقیاس را بر اساس ناحیه نمایش و محدودیت‌های دستگاه انتخاب می‌کند. برای اعمال تغییر، MIDlet را دوباره راه‌اندازی کنید.</string>
