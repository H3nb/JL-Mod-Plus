<!-- Shared UI actions, generic labels, dialogs, and About screen. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="about">О апликацији</string>
    <string name="about_message">Покрећите класичне апликације и игре, организујте MIDlet-е у библиотеци и прилагодите контроле, приказ, звук и перформансе. JL-Mod Plus је бесплатан софтвер отвореног кода.</string>
    <string name="about_subtitle">Java ME емулатор за Android</string>
    <string name="about_compatibility">Компатибилност зависи од MIDlet-а, уређаја и подржаних Java ME API-ја. Неке апликације могу да раде другачије него на оригиналним уређајима.</string>
    <string name="about_lineage_title">Порекло пројекта</string>
    <string name="about_build_title">Информације о верзији</string>
    <string name="about_version_label">Верзија</string>
    <string name="about_build_label">Издање</string>
    <string name="about_revision_label">Ревизија изворног кода</string>
    <string name="about_links_title">Пројекат и лиценце</string>
    <string name="about_github_link_copied">Није пронађен прегледач. GitHub веза је копирана у привремену меморију.</string>
    <string name="about_github_browser_unavailable">Није пронађен прегледач за отварање GitHub-а.</string>
    <string name="about_lineage">JL-Mod Plus је независна грана пројекта JL-Mod аутора woesss (Јуриј Харченко). JL-Mod је заснован на апликацији J2ME Loader Никите Шакаруна, која потиче од NaikSoftware J2meLoader-а.</string>
    <string name="about_evolution">JL-Mod Plus надограђује ту основу савременим интерфејсом, напреднијом библиотеком MIDlet-а, новим функцијама и подршком за новије верзије Android-а.</string>
