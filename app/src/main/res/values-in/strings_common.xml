    <string name="about">Tentang</string>
    <string name="about_message">Jalankan aplikasi dan game klasik, kelola MIDlet di pustaka, serta sesuaikan kontrol, tampilan, audio, dan performa. JL-Mod Plus adalah aplikasi gratis dengan kode sumber terbuka.</string>
    <string name="about_subtitle">Emulator Java ME untuk Android</string>
    <string name="about_compatibility">Kompatibilitas bergantung pada MIDlet, perangkat, dan API Java ME yang didukung. Beberapa aplikasi mungkin berjalan berbeda dari saat digunakan di perangkat aslinya.</string>
    <string name="about_lineage_title">Asal-usul proyek</string>
    <string name="about_build_title">Informasi build</string>
    <string name="about_version_label">Versi</string>
    <string name="about_build_label">Build</string>
    <string name="about_revision_label">Revisi kode sumber</string>
    <string name="about_links_title">Proyek dan lisensi</string>
    <string name="about_github_link_copied">Browser tidak ditemukan. Tautan GitHub disalin ke papan klip.</string>
    <string name="about_github_browser_unavailable">Tidak ada browser yang dapat membuka GitHub.</string>
    <string name="about_lineage">JL-Mod Plus adalah fork independen dari JL-Mod karya woesss (Yury Kharchenko). JL-Mod berbasis J2ME Loader karya Nikita Shakarun, yang berakar dari J2meLoader karya NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus melanjutkan pengembangan tersebut dengan antarmuka modern, pengelolaan MIDlet yang lebih lengkap, fitur baru, serta dukungan untuk versi Android yang lebih baru.</string>
