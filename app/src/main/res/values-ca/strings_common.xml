    <string name="about">Quant a</string>
    <string name="about_message">Executa aplicacions i jocs clàssics, organitza els MIDlets a la biblioteca i personalitza els controls, la pantalla, l’àudio i el rendiment. JL-Mod Plus és gratuït i de codi obert.</string>
    <string name="about_subtitle">Emulador de Java ME per a Android</string>
    <string name="about_compatibility">La compatibilitat depèn del MIDlet, del dispositiu i de les API de Java ME compatibles. Algunes aplicacions poden comportar-se de manera diferent de com ho feien als telèfons originals.</string>
    <string name="about_lineage_title">Orígens del projecte</string>
    <string name="about_build_title">Informació de compilació</string>
    <string name="about_version_label">Versió</string>
    <string name="about_build_label">Compilació</string>
    <string name="about_revision_label">Revisió del codi font</string>
    <string name="about_links_title">Projecte i llicències</string>
    <string name="about_github_link_copied">No s’ha trobat cap navegador. L’enllaç de GitHub s’ha copiat al porta-retalls.</string>
    <string name="about_github_browser_unavailable">No s’ha trobat cap navegador per obrir GitHub.</string>
    <string name="about_lineage">JL-Mod Plus és una bifurcació independent de JL-Mod de woesss (Yury Kharchenko). JL-Mod es basa en J2ME Loader de Nikita Shakarun, que deriva de J2meLoader de NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus amplia aquesta base amb una interfície moderna, una biblioteca de MIDlets més potent, funcions noves i compatibilitat amb versions més recents d’Android.</string>
