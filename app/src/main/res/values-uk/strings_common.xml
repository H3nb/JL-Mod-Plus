<!-- Shared UI actions, generic labels, dialogs, and About screen. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="about">Про додаток</string>
    <string name="about_message">Запускайте класичні додатки та ігри, упорядковуйте MIDlet у своїй бібліотеці й налаштовуйте керування, екран, звук і продуктивність. JL-Mod Plus — безкоштовний проєкт із відкритим кодом.</string>
    <string name="about_subtitle">Емулятор Java ME для Android</string>
    <string name="about_compatibility">Сумісність залежить від MIDlet, пристрою та підтримуваних API Java ME. Деякі додатки можуть працювати інакше, ніж на оригінальних телефонах.</string>
    <string name="about_lineage_title">Походження проєкту</string>
    <string name="about_build_title">Інформація про збірку</string>
    <string name="about_version_label">Версія</string>
    <string name="about_build_label">Збірка</string>
    <string name="about_revision_label">Ревізія коду</string>
    <string name="about_links_title">Проєкт і ліцензії</string>
    <string name="about_github_link_copied">Браузер не знайдено. Посилання на GitHub скопійовано в буфер обміну.</string>
    <string name="about_github_browser_unavailable">Браузер для відкриття GitHub не знайдено.</string>
    <string name="about_lineage">JL-Mod Plus — незалежне відгалуження JL-Mod від woesss (Юрія Харченка). JL-Mod створено на основі J2ME Loader Микити Шакаруна, який бере початок від J2meLoader від NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus розвиває цю основу, пропонуючи сучасний інтерфейс, розширену бібліотеку MIDlet, нові можливості та підтримку новіших версій Android.</string>
