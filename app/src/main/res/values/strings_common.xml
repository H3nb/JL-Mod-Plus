    <string name="about">About</string>
    <string name="about_message">Run classic apps and games, organize MIDlets in your library, and customize controls, display, audio, and performance. JL-Mod Plus is free and open source.</string>
    <string name="about_subtitle">Java ME emulator for Android</string>
    <string name="about_compatibility">Compatibility depends on the MIDlet, device, and supported Java ME APIs. Some apps may not behave exactly as they did on their original devices.</string>
