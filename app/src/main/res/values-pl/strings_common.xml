    <string name="about">O aplikacji</string>
    <string name="about_message">Uruchamiaj klasyczne aplikacje i gry, porządkuj MIDlety w swojej bibliotece oraz dostosowuj sterowanie, ekran, dźwięk i wydajność. JL-Mod Plus jest bezpłatny i ma otwarty kod źródłowy.</string>
    <string name="about_subtitle">Emulator Java ME dla Androida</string>
    <string name="about_compatibility">Zgodność zależy od MIDletu, urządzenia i obsługiwanych interfejsów API Java ME. Niektóre aplikacje mogą działać inaczej niż na oryginalnych urządzeniach.</string>
    <string name="about_lineage_title">Pochodzenie projektu</string>
    <string name="about_build_title">Informacje o kompilacji</string>
    <string name="about_version_label">Wersja</string>
    <string name="about_build_label">Kompilacja</string>
    <string name="about_revision_label">Wersja kodu źródłowego</string>
    <string name="about_links_title">Projekt i licencje</string>
    <string name="about_github_link_copied">Nie znaleziono przeglądarki. Link do GitHuba skopiowano do schowka.</string>
    <string name="about_github_browser_unavailable">Nie znaleziono przeglądarki do otwarcia GitHuba.</string>
    <string name="about_lineage">JL-Mod Plus to niezależny fork JL-Mod autorstwa woesss (Yury Kharchenko). JL-Mod opiera się na J2ME Loader autorstwa Nikity Shakaruna, który wywodzi się z J2meLoader od NaikSoftware.</string>
    <string name="about_evolution">JL-Mod Plus rozwija te podstawy, oferując nowoczesny interfejs, bardziej rozbudowaną bibliotekę MIDletów, nowe funkcje oraz obsługę nowszych wersji Androida.</string>
