    <string name="config_font_sizes">Rozmiary czcionki</string>
    <string name="config_help_font_sizes">Ustawia mały, średni i duży rozmiar czcionki Java ME dla MIDletu.</string>
    <string name="config_help_font_sizes_long">Ustawia rozmiary czcionek Java ME w pikselach lub jednostkach skalowanych, gdy włączona jest skala czcionki Androida. Zmieniaj je razem, aby zachować spójność tekstu.</string>
    <string name="config_font_sizes_value">Mała <xliff:g id="small_size" example="12">%1$s</xliff:g> · średnia <xliff:g id="medium_size" example="16">%2$s</xliff:g> · duża <xliff:g id="large_size" example="20">%3$s</xliff:g></string>
    <string name="config_help_font_presets">Stosuje rozmiary czcionek dopasowane do popularnych rozdzielczości ekranów Java ME.</string>
